{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BrowserTabsObserveParams",
  "type": "object",
  "required": [
    "browser_id",
    "expected_origin",
    "tab_id"
  ],
  "properties": {
    "browser_id": {
      "type": "string"
    },
    "expected_origin": {
      "type": "string"
    },
    "max_chars": {
      "default": 4000,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    }
  },
  "additionalProperties": false
}
